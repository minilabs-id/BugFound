/target
/.agentbug
/agentbug.toml
**/*.rs.bk

# Evaluation scratch space only. eval/results/ is intentionally tracked so an
# operator can commit recorded benchmark artifacts.
/eval/work/
__pycache__/
*.pyc

# Local research clones (third-party repos); not part of AgentBug source.
/research/

# Evidence artifacts are generated under the engagement workspace, never in source.
**/evidence/*.bin
