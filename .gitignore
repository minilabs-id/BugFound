/target
/.bugfound
/bugfound.toml
**/*.rs.bk

# Evaluation scratch space only. eval/results/ is intentionally tracked so an
# operator can commit recorded benchmark artifacts.
/eval/work/
__pycache__/
*.pyc

# Local research clones (third-party repos); not part of BugFound source.
/research/

# Evidence artifacts are generated under the engagement workspace, never in source.
**/evidence/*.bin

# Node dependencies for local browser adapters and the Tauri frontend.
node_modules/
/frontend/dist/
